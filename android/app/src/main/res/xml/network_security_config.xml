<?xml version="1.0" encoding="utf-8"?>
<!--
  Plunge Tracker is fully offline and declares no INTERNET permission, so
  the app cannot reach the network at all. This file is therefore belt and
  braces rather than the thing doing the work.

  It is kept because it costs nothing and fails safe: if INTERNET is ever
  added back - by a future dependency, or by regenerating the Capacitor
  template, which declares it by default - cleartext is still denied and
  only the system CA store is trusted, never user-installed CAs. That
  closes the window where a new permission quietly enables traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
