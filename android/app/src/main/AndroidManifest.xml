<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      This app requests no permissions.

      Not even INTERNET. Capacitor's template declares it, but nothing here
      needs it: the WebView never makes a network request. Every asset is
      served out of the APK by WebViewLocalServer.shouldInterceptRequest(),
      which hands back a stream from AndroidProtocolHandler.openAsset() ->
      context.getAssets().open(). The https://localhost origin is only a name,
      required so the page counts as a secure context for IndexedDB.

      None of the Capacitor libraries in use (@capacitor/android, filesystem,
      share) declare permissions either, so nothing is merged back in.

      Deliberately NOT requested: internet, storage, camera, location,
      notifications. Session data lives in the WebView's own IndexedDB (see
      src/lib/db.ts) and preferences in localStorage.

      The built APK still lists a generated
      *.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION, injected by AndroidX Core.
      It is scoped to this app's own package with protectionLevel="signature",
      so it grants nothing to anything not signed with the same key.
    -->
</manifest>
