<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      The only permission this app declares by hand.

      (The built APK also carries a generated
      *.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION entry, injected by AndroidX
      Core. It is scoped to this app's own package with
      protectionLevel="signature", so it grants nothing to anything not signed
      with the same key.)

      INTERNET is required by Capacitor: the WebView loads the bundled app from an
      intercepted https://localhost origin, which goes through Android's network
      stack even though the bytes come from the APK's assets. No request reaches
      the network - see res/xml/network_security_config.xml, which denies
      cleartext and user-installed CAs.

      Deliberately NOT requested: storage, camera, location, notifications.
      All session data lives in the WebView's own IndexedDB (see src/lib/db.ts).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
